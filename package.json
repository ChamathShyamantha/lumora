{
  "name": "lumora",
  "productName": "Lumora",
  "version": "0.1.0",
  "description": "Free, open RGB lighting studio — every effect free, easy to create your own.",
  "main": "./out/main/index.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify:effects": "node scripts/verify-effects.mjs",
    "dist": "electron-vite build && electron-builder --win --publish never"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "openrgb-sdk": "^0.6.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@uiw/react-codemirror": "^4.25.12",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  },
  "author": {
    "name": "Chamath Shyamantha",
    "url": "https://www.chamathshyamantha.online/"
  },
  "homepage": "https://github.com/ChamathShyamantha/lumora-releases",
  "build": {
    "appId": "app.lumora",
    "productName": "Lumora",
    "copyright": "Copyright © 2026 Chamath Shyamantha",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/effects",
        "to": "effects",
        "filter": [
          "*.html"
        ]
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lumora",
      "artifactName": "Lumora-Setup.${ext}",
      "uninstallDisplayName": "Lumora"
    },
    "publish": {
      "provider": "github",
      "owner": "ChamathShyamantha",
      "repo": "lumora-releases"
    }
  }
}
